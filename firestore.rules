rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function companyDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId));
    }

    function memberDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function isCompanyMember(companyId) {
      return signedIn() && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function companyRole(companyId) {
      return memberDoc(companyId).data.role;
    }

    function isCompanyManager(companyId) {
      return isCompanyMember(companyId) && companyRole(companyId) in ['owner', 'manager'];
    }

    function isCompanyOwner(companyId) {
      return isCompanyMember(companyId) && companyRole(companyId) == 'owner';
    }

    function isOwnerBootstrap(companyId, uid) {
      return signedIn()
        && uid == request.auth.uid
        && companyDoc(companyId).data.ownerId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'owner';
    }

    match /users/{uid} {
      allow read, create, update: if isSelf(uid);
      allow delete: if false;

      // My Space is physically isolated from Company Space.
      match /personalTasks/{taskId} {
        allow read, create, update, delete: if isSelf(uid)
          && (request.method != 'create' || request.resource.data.ownerId == request.auth.uid)
          && (request.method == 'create' || resource.data.ownerId == request.auth.uid);
      }
    }

    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isCompanyOwner(companyId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isCompanyMember(companyId);
        allow create: if isCompanyOwner(companyId) || isOwnerBootstrap(companyId, uid);
        allow update, delete: if isCompanyOwner(companyId) && uid != request.auth.uid;
      }

      match /tasks/{taskId} {
        allow read: if isCompanyManager(companyId)
          || (isCompanyMember(companyId)
            && (resource.data.assigneeId == request.auth.uid
              || resource.data.createdBy == request.auth.uid));

        allow create: if isCompanyMember(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.createdBy == request.auth.uid;

        allow update: if isCompanyManager(companyId)
          || (isCompanyMember(companyId)
            && resource.data.assigneeId == request.auth.uid
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.createdBy == resource.data.createdBy);

        allow delete: if isCompanyManager(companyId)
          || (isCompanyMember(companyId) && resource.data.createdBy == request.auth.uid);
      }

      match /sops/{sopId} {
        allow read: if isCompanyMember(companyId);
        allow create, update, delete: if isCompanyManager(companyId);
      }

      match /automations/{automationId} {
        allow read: if isCompanyMember(companyId);
        allow create, update, delete: if isCompanyManager(companyId);
      }
    }

    // Invite documents are server-managed only.
    match /companyInvites/{inviteId} {
      allow read, write: if false;
    }

    // Legacy mapping is disabled after migration.
    match /user_mappings/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
